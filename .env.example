# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/sentrix_db

# JWT
JWT_SECRET=generate-a-strong-secret-here
JWT_EXPIRES_IN=7d

# Server
PORT=4800
NODE_ENV=development
CORS_ORIGIN=https://sentrix-pmo.com,http://localhost:8686

# Email (for notifications later)
SMTP_HOST=
