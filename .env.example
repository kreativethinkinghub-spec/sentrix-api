# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/sentrix_db

# JWT
JWT_SECRET=generate-a-strong-secret-here
JWT_EXPIRES_IN=7d

# Server
PORT=4800
NODE_ENV=development
CORS_ORIGIN=https://sentrix-pmo.com,http://localhost:8686
APP_URL=https://sentrix-pmo.com

# Paystack (billing) — set these in your host's secret env, NEVER commit real keys.
# Billing stays inert until PAYSTACK_SECRET_KEY is present.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Twilio (WhatsApp/SMS alerts) — inert until set. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Email (for notifications later)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=sentrix@kth-tech.com
